# Pinned third-party binaries bundled into Castor packages.
# Read by packaging/windows/build.ps1 and packaging/macos/build.sh (KEY=VALUE, no quotes, no spaces).
# Every download is checked against the SHA-256 below before it is unpacked. To bump a pin:
# change URL + SHA together, take the SHA from the publisher's checksum file / GitHub asset digest,
# never from your own download.

# --- FFmpeg, Windows x64: BtbN GPL shared build (month-end autobuilds are kept long-term) -------
# https://github.com/BtbN/FFmpeg-Builds/releases/tag/autobuild-2026-10-31-12-59
FFMPEG_WIN_VERSION=n9.0.2-39-g7adfbe40dc
FFMPEG_WIN_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-10-31-12-59/ffmpeg-n9.0.2-39-g7adfbe40dc-win64-gpl-shared-9.0.zip
FFMPEG_WIN_SHA256=1d9823c35c7a7e2f54d1438cf61030d6efabe3278de01c191309d1e828bb74df
FFMPEG_WIN_SOURCE=https://github.com/FFmpeg/FFmpeg/tree/n9.0.2
FFMPEG_WIN_BUILD_SCRIPTS=https://github.com/BtbN/FFmpeg-Builds/tree/autobuild-2026-10-31-12-59

# --- whisper.cpp (whisper-cli), built from source on each OS ------------------------------------
WHISPER_REPO=https://github.com/ggml-org/whisper.cpp.git
WHISPER_TAG=v1.9.5
WHISPER_COMMIT=d1be6fde11ac6e0407606b4e42fe72d34add8037

# --- FFmpeg, macOS: martin-riedl.de static GPL builds (notarised zips), per arch ---------------
# https://ffmpeg.martin-riedl.de (release channel 9.0.2). SHA-256 from the site's *.zip.sha256 files.
# Note: these builds have no libvidstab (video.stabilize falls back to deshake on macOS).
FFMPEG_MAC_VERSION=9.0.2
FFMPEG_MAC_X64_FFMPEG_URL=https://ffmpeg.martin-riedl.de/download/macos/amd64/1789931006_9.0.2/ffmpeg.zip
FFMPEG_MAC_X64_FFMPEG_SHA256=7c6b4125b191cbf773832dc51f424cf2b6bb7da43007d1e066f95909e47cacd4
FFMPEG_MAC_X64_FFPROBE_URL=https://ffmpeg.martin-riedl.de/download/macos/amd64/1789931006_9.0.2/ffprobe.zip
FFMPEG_MAC_X64_FFPROBE_SHA256=2322438ed2f6319a691291b247d09c69dcaa3a982460d1f269a7e1af335cfdfd
FFMPEG_MAC_ARM64_FFMPEG_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1789931890_9.0.2/ffmpeg.zip
FFMPEG_MAC_ARM64_FFMPEG_SHA256=c8ed4c4e6978a03c485edbfe4e0a5dc2380f8a30bba5150531b31b094492d924
FFMPEG_MAC_ARM64_FFPROBE_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1789931890_9.0.2/ffprobe.zip
FFMPEG_MAC_ARM64_FFPROBE_SHA256=fcbe839537485eaee7a7a8bc5cbc0f90d53617e80943e8a5b2e31cb851197ea6
FFMPEG_MAC_SOURCE=https://github.com/FFmpeg/FFmpeg/tree/n9.0.2
FFMPEG_MAC_BUILD_SCRIPTS=https://git.martin-riedl.de/ffmpeg/build-script

# --- ONNX Runtime for Intel Macs (Microsoft's last x86_64 macOS build), see spec B ---------------
ORT_MAC_X64_VERSION=1.23.2
ORT_MAC_X64_URL=https://github.com/microsoft/onnxruntime/releases/download/v1.23.2/onnxruntime-osx-x86_64-1.23.2.tgz
ORT_MAC_X64_SHA256=d10359e16347b57d9959f7e80a225a5b4a66ed7d7e007274a15cae86836485a6

# --- Corresponding source of the bundled GPL/MIT helpers (packaging/sources.sh) -----------------
# Archived with `git archive` from these exact commits and attached to every GitHub release.
FFMPEG_REPO=https://github.com/FFmpeg/FFmpeg.git
# Windows build n9.0.2-39-g7adfbe40dc (release/9.0 branch):
FFMPEG_WIN_COMMIT=7adfbe40dcde598f93a6963d2f7b22cd75202ccc
# macOS build 9.0.2 = tag n9.0.2:
FFMPEG_MAC_COMMIT=946fcce07b6dcd0331c8cc609192aeff5e1924f8
BTBN_REPO=https://github.com/BtbN/FFmpeg-Builds.git
BTBN_COMMIT=5031c6f1082414e53688d39e521849905071070d
MRIEDL_REPO=https://git.martin-riedl.de/ffmpeg/build-script.git
MRIEDL_COMMIT=f63b8aab8f5ce1a067da86ba69e34a36a7e217e5

# --- Packaging tools ------------------------------------------------------------------------------
# vpk must match the `velopack` crate version used by castor-app (crates/castor-app/Cargo.toml).
VPK_VERSION=1.3.39-g8d2844f
# macOS DMG builder (PyPI, installed in a venv under the target dir; MIT).
DMGBUILD_VERSION=1.6.5
APP_ID=Castor
APP_TITLE=Castor
APP_AUTHORS=basedpolymer
MAC_BUNDLE_ID=eu.basedpolymer.castor
